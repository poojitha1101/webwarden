# Application
APP_NAME=WebWarden
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# CORS (JSON array or comma-separated origins)
CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL connection string (replace with your local credentials in .env)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/webwarden
